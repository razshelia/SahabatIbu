+        $tambah('TWICE', 'Chaeyoung Ramadhani',   'menunggu', 'mandiri', 'umum', 0, ['alamat' => 'Perumahan Tegal Besar Indah B-9, Kaliwates, Jember', 'hari_daftar' => 0]);
+
+        return $out;
