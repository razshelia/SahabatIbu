+        $tambah('aespa', 'Winter Purnama',     'aktif',    'mandiri', 'warga', 7);
+        $tambah('aespa', 'Ningning Susanti',   'menunggu', 'mandiri', 'warga', 0, ['hari_daftar' => 1]);
+
+        // Nasabah umum (bukan warga Taman Gading): alamat bebas
