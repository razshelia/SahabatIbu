+<?php
+
+namespace Database\Seeders;
+
+use App\Models\Nasabah;
+use App\Models\PenarikanDana;
+use App\Models\TransaksiSetoran;
+use App\Models\User;
+use App\Services\PenarikanDanaService;
+use Database\Seeders\Concerns\HanyaNonProduksi;
+use Illuminate\Database\Seeder;
+use Illuminate\Support\Carbon;
+
+/**
+ * Pengajuan penarikan dana dummy dengan semua status (hanya pengembangan/pengujian).
+ *
+ * Dibuat lewat PenarikanDanaService dengan tanggal mundur: saldo ditahan, saldo berkurang saat
+ * dicairkan, dan log aktivitas mengikuti aturan aplikasi (BR-06, BR-07, BR-09). Nominal dihitung
+ * dari saldo nasabah PADA tanggal pengajuan. Nasabah yang sudah punya penarikan dilewati.
+ */
+class PenarikanDemoSeeder extends Seeder
+{
+    use HanyaNonProduksi;
+
+    private const ALASAN_TOLAK_KAS = 'Kas tunai pengurus belum tersedia hari ini (pengurus sedang di Surabaya nonton konser). Silakan ajukan lagi hari Senin.';
+    private const ALASAN_TOLAK_REKENING = 'Nomor rekening/e-wallet tidak valid. Mohon cek lagi lalu ajukan ulang.';
+
+    /**
+     * email, hasil akhir, metode, bagian saldo yang ditarik (1 = semua), berapa hari lalu diajukan, rekening (bank, nomor)
+     */
+    private const RENCANA = [
+        ['jungkook.bts@example.test',     'dicairkan', 'tunai',    0.50, 30, null],
+        ['jungkook.bts@example.test',     'menunggu',  'transfer', 0.30, 1,  ['BCA', '8830214467']],
+        ['jisoo.blackpink@example.test',  'dicairkan', 'transfer', 0.60, 21, ['BRI', '002301045678509']],
+        ['jennie.blackpink@example.test', 'dicairkan', 'tunai',    0.40, 25, null],
+        ['jennie.blackpink@example.test', 'disetujui', 'tunai',    0.30, 2,  null],
+        ['lisa.blackpink@example.test',   'dicairkan', 'transfer', 0.50, 16, ['GoPay', '081230004455']],
+        ['jimin.bts@example.test',        'dicairkan', 'tunai',    0.50, 18, null],
+        ['jimin.bts@example.test',        'ditolak',   'tunai',    0.30, 6,  null],
+        ['hoseok.bts@example.test',       'disetujui', 'transfer', 0.40, 1,  ['BNI', '0457812390']],
+        ['minji.newjeans@example.test',   'menunggu',  'tunai',    0.35, 0,  null],
+        ['hanni.newjeans@example.test',   'dibatalkan', 'tunai',   0.20, 4,  null],
+        ['karina.aespa@example.test',     'dicairkan', 'tunai',    0.50, 12, null],
+        ['winter.aespa@example.test',     'ditolak',   'transfer', 0.50, 3,  ['DANA', '08129998877']],
+        ['rose.blackpink@example.test',   'menunggu',  'transfer', 0.30, 2,  ['Mandiri', '1400012345678']],
+        ['seokjin.bts@example.test',      'dicairkan', 'tunai',    1.00, 14, null],   // dikosongkan -> nanti nonaktif, bisa dianonimkan
+        ['yoongi.bts@example.test',       'dicairkan', 'tunai',    0.60, 15, null],   // masih ada sisa saldo
+    ];
+
+    public function run(): void
+    {
+        $this->tolakDiProduksi();
+
+        $admin = $this->ambilAdmin();
+        $layanan = app(PenarikanDanaService::class);
+        $sekarang = Carbon::now();
+
+        // Urutkan dari yang paling lama supaya saldo per tanggal masuk akal.
+        $rencana = collect(self::RENCANA)->sortByDesc(fn ($r) => $r[4])->values();
+
+        mt_srand(2612);   // menit pengajuan tetap sama setiap dijalankan
+
+        $hitung = array_fill_keys(['menunggu', 'disetujui', 'dicairkan', 'ditolak', 'dibatalkan'], 0);
+        $sudahPunya = [];
+
+        try {
+            foreach ($rencana as [$email, $hasil, $metode, $bagian, $hariLalu, $rekening]) {
+                $nasabah = $this->cariNasabah($email);
+                if (! $nasabah) {
+                    $this->command?->warn("Lewati {$email}: nasabah belum ada.");
+                    continue;
+                }
+
+                // Lewati bila nasabah ini sudah punya penarikan sebelum seeder ini dijalankan.
+                $sudahPunya[$nasabah->id] ??= PenarikanDana::where('nasabah_id', $nasabah->id)->exists();
+                if ($sudahPunya[$nasabah->id]) {
+                    continue;
+                }
+
+                $diajukan = $sekarang->copy()->startOfDay()->subDays($hariLalu)->setTime(10, mt_rand(0, 59));
+                if ($diajukan->greaterThan($sekarang->copy()->subMinutes(30))) {
+                    $diajukan = $sekarang->copy()->subMinutes(30);
+                }
+
+                $nominal = $this->hitungNominal($nasabah, $diajukan, $bagian);
+                if ($nominal === null) {
+                    $this->command?->warn("Lewati {$email}: saldo pada tanggal itu terlalu kecil.");
+                    continue;
+                }
+
+                Carbon::setTestNow($diajukan);
+                $penarikan = $layanan->ajukanPenarikan(
+                    $nasabah->fresh(),
+                    $nominal,
+                    $metode,
+                    $rekening[0] ?? null,
+                    $rekening[1] ?? null,
+                    $metode === 'transfer' ? $nasabah->user->name : null,
+                );
+
+                $this->selesaikan($layanan, $penarikan, $nasabah, $admin, $hasil, $metode, $diajukan, $sekarang);
+                $hitung[$hasil]++;
+            }
+        } finally {
+            Carbon::setTestNow();
+            mt_srand();
+        }
+
+        $this->command?->info('PenarikanDemoSeeder: ' . array_sum($hitung) . ' pengajuan dibuat ('
+            . collect($hitung)->map(fn ($j, $s) => "{$j} {$s}")->implode(', ') . ').');
+    }
+
+    private function cariNasabah(string $email): ?Nasabah
+    {
+        $user = User::where('email', $email)->first();
+
+        return $user ? Nasabah::where('user_id', $user->id)->first() : null;
+    }
+
+    /**
+     * Saldo nasabah pada tanggal tertentu (setoran berhasil sampai tanggal itu dikurangi penarikan
+     * yang masih berjalan atau sudah cair), lalu ambil sebagian. Pembulatan ke kelipatan Rp 5.000
+     * (sama dengan tombol di form), kecuali "semua saldo" yang dipakai persis.
+     */
+    private function hitungNominal(Nasabah $nasabah, Carbon $pada, float $bagian): ?float
+    {
+        $masuk = (float) TransaksiSetoran::where('nasabah_id', $nasabah->id)
+            ->where('status', 'berhasil')->where('tanggal', '<=', $pada)->sum('total_nilai');
+        $keluar = (float) PenarikanDana::where('nasabah_id', $nasabah->id)
+            ->whereIn('status', ['menunggu', 'disetujui', 'dicairkan'])->sum('nominal');
+        $tersedia = $masuk - $keluar;
+
+        if ($bagian >= 1.0) {
+            return $tersedia >= 5000 ? round($tersedia, 2) : null;
+        }
+
+        $nominal = floor(($tersedia * $bagian) / 5000) * 5000;
+
+        return $nominal >= 5000 ? (float) $nominal : null;
+    }
+
+    private function selesaikan(
+        PenarikanDanaService $layanan,
+        PenarikanDana $penarikan,
+        Nasabah $nasabah,
+        User $admin,
+        string $hasil,
+        string $metode,
+        Carbon $diajukan,
+        Carbon $sekarang,
+    ): void {
+        $paling = fn (Carbon $t) => $t->greaterThan($sekarang) ? $sekarang->copy()->subMinutes(5) : $t;
+
+        match ($hasil) {
+            'menunggu' => null,
+
+            'dibatalkan' => $this->pada($paling($diajukan->copy()->addHours(3)), fn () => $layanan->batalkanOlehNasabah($penarikan->fresh(), $nasabah->fresh())),
+
+            'ditolak' => $this->pada($paling($diajukan->copy()->addHours(5)), fn () => $layanan->tolakPenarikan(
+                $penarikan->fresh(),
+                $metode === 'transfer' ? self::ALASAN_TOLAK_REKENING : self::ALASAN_TOLAK_KAS,
+                $admin,
+            )),
+
+            'disetujui' => $this->pada($paling($diajukan->copy()->addHours(4)), fn () => $layanan->setujuiPenarikan($penarikan->fresh(), $admin)),
+
+            'dicairkan' => (function () use ($layanan, $penarikan, $admin, $metode, $diajukan, $paling) {
+                $this->pada($paling($diajukan->copy()->addHours(4)), fn () => $layanan->setujuiPenarikan($penarikan->fresh(), $admin));
+                $this->pada($paling($diajukan->copy()->addDay()->setTime(13, 20)), fn () => $layanan->cairkanPenarikan(
+                    $penarikan->fresh(),
+                    $admin,
+                    $metode === 'transfer' ? 'Transfer ' . $penarikan->nama_bank . ', bukti #' . strtoupper(substr(md5($penarikan->kode), 0, 8)) : 'Diserahkan tunai di pos pengurus',
+                ));
+            })(),
+        };
+    }
+
+    private function pada(Carbon $waktu, callable $aksi): void
+    {
+        Carbon::setTestNow($waktu);
+        $aksi();
+    }
+}
diff --git a/database/seeders/SetoranDemoSeeder.php b/database/seeders/SetoranDemoSeeder.php
new file mode 100644
index 0000000..19277a7
--- /dev/null
+++ b/database/seeders/SetoranDemoSeeder.php
@@ -0,0 +1,220 @@
+<?php
+
+namespace Database\Seeders;
+
+use App\Models\HargaSampah;
+use App\Models\JenisSampah;
+use App\Models\Nasabah;
+use App\Models\TransaksiSetoran;
+use App\Models\User;
+use App\Services\TransaksiSetoranService;
+use Database\Seeders\Concerns\HanyaNonProduksi;
+use Database\Seeders\Support\DemoRoster;
+use Illuminate\Database\Seeder;
+use Illuminate\Support\Carbon;
+use RuntimeException;
+
+/**
+ * Jenis sampah tambahan, riwayat harga, dan riwayat setoran untuk nasabah demo (hanya pengembangan).
+ *
+ * Setoran dibuat lewat TransaksiSetoranService dengan tanggal mundur, sehingga harga yang dipakai
+ * adalah harga yang berlaku PADA tanggal itu (riwayat harga naik/turun ikut terbentuk), saldo
+ * bertambah dengan benar, dan log aktivitas tercatat. Beberapa setoran sengaja dibatalkan (BR-10).
+ * Hasilnya sama setiap dijalankan (angka acak memakai benih tetap). Nasabah yang sudah punya
+ * setoran dilewati, jadi aman dijalankan ulang.
+ */
+class SetoranDemoSeeder extends Seeder
+{
+    use HanyaNonProduksi;
+
+    private const BENIH = 2611;
+
+    /** Setoran ke-n milik nasabah (email) yang dibatalkan sebentar setelah dicatat. */
+    private const DIBATALKAN = [
+        'jisoo.blackpink@example.test'     => 2,
+        'hanni.newjeans@example.test'      => 3,
+        'karina.aespa@example.test'        => 2,
+        'jungkook.bts@example.test'        => 4,
+    ];
+
+    /** Nasabah yang punya setoran hari ini (agar "setoran hari ini" di dashboard admin terisi). */
+    private const SETORAN_HARI_INI = [
+        'jungkook.bts@example.test',
+        'jisoo.blackpink@example.test',
+        'jimin.bts@example.test',
+    ];
+
+    public function run(): void
+    {
+        $this->tolakDiProduksi();
+
+        $this->call([JenisSampahSeeder::class, HargaSampahSeeder::class]);
+
+        $admin = $this->ambilAdmin();
+        $jenis = $this->siapkanJenisDanHarga($admin);
+        $layanan = app(TransaksiSetoranService::class);
+
+        $peristiwa = $this->susunPeristiwa();
+        if ($peristiwa === []) {
+            $this->command?->warn('SetoranDemoSeeder: tidak ada nasabah demo yang perlu diisi (jalankan NasabahDemoSeeder dulu, atau data sudah ada).');
+
+            return;
+        }
+
+        $dibuat = 0;
+        $dibatalkan = 0;
+
+        try {
+            foreach ($peristiwa as $p) {
+                Carbon::setTestNow($p['waktu']);
+
+                $items = [];
+                foreach ($p['items'] as $nama => $berat) {
+                    $items[] = ['jenis_sampah_id' => $jenis[$nama]->id, 'berat_kg' => $berat];
+                }
+
+                $transaksi = $layanan->simpanSetoran($p['nasabah_id'], $items, $admin);
+                $dibuat++;
+
+                if ($p['batal'] !== null) {
+                    Carbon::setTestNow($p['waktu']->copy()->addMinutes(35));
+                    $layanan->batalkanSetoran($transaksi, $p['batal'], $admin);
+                    $dibatalkan++;
+                }
+            }
+        } finally {
+            Carbon::setTestNow();
+        }
+
+        $this->command?->info("SetoranDemoSeeder: {$dibuat} setoran dibuat ({$dibatalkan} di antaranya dibatalkan).");
+    }
+
+    /**
+     * Pastikan jenis demo ada dan seluruh jenis punya riwayat harga sejak sebelum setoran tertua.
+     *
+     * @return array<string, JenisSampah> nama => jenis (hanya yang aktif dan boleh disetor)
+     */
+    private function siapkanJenisDanHarga(User $admin): array
+    {
+        $riwayat = DemoRoster::RIWAYAT_JENIS_BAWAAN;
+
+        foreach (DemoRoster::JENIS_TAMBAHAN as $nama => [$aktif, $harga]) {
+            JenisSampah::firstOrCreate(['nama' => $nama], ['satuan' => 'kg', 'aktif' => $aktif]);
+            $riwayat[$nama] = $harga;
+        }
+
+        foreach ($riwayat as $nama => $daftarHarga) {
+            $jenis = JenisSampah::where('nama', $nama)->firstOrFail();
+
+            foreach ($daftarHarga as $hariLalu => $harga) {
+                $tanggal = Carbon::now()->subDays($hariLalu)->toDateString();
+
+                // whereDate (bukan firstOrCreate dengan tanggal polos): di SQLite kolom tersimpan
+                // sebagai "Y-m-d 00:00:00" sehingga pencarian "Y-m-d" tidak menemukannya dan
+                // menabrak unique(jenis_sampah_id, berlaku_mulai) saat seeder dijalankan ulang.
+                $sudah = HargaSampah::where('jenis_sampah_id', $jenis->id)->whereDate('berlaku_mulai', $tanggal)->exists();
+                if (! $sudah) {
+                    HargaSampah::create([
+                        'jenis_sampah_id' => $jenis->id,
+                        'harga_per_kg'    => $harga,
+                        'berlaku_mulai'   => $tanggal,
+                        'dibuat_oleh'     => $admin->id,
+                    ]);
+                }
+            }
+        }
+
+        return JenisSampah::where('aktif', true)->whereIn('nama', array_keys(DemoRoster::KISARAN_BERAT))
+            ->get()->keyBy('nama')->all();
+    }
+
+    /**
+     * Susun semua setoran (tanggal, nasabah, isi) lalu urutkan dari yang paling lama.
+     *
+     * @return list<array{waktu:Carbon,nasabah_id:int,items:array<string,float>,batal:?string}>
+     */
+    private function susunPeristiwa(): array
+    {
+        mt_srand(self::BENIH);
+
+        $nama = array_keys(DemoRoster::KISARAN_BERAT);
+        $sekarang = Carbon::now();
+        $acara = [];
+        $alasan = DemoRoster::ALASAN_BATAL_SETORAN;
+        $noAlasan = 0;
+
+        foreach (DemoRoster::nasabah() as $n) {
+            if ($n['setoran'] < 1) {
+                continue;
+            }
+
+            $user = User::where('email', $n['email'])->first();
+            $nasabah = $user ? Nasabah::where('user_id', $user->id)->first() : null;
+
+            if (! $nasabah) {
+                $this->command?->warn("Lewati {$n['email']}: belum ada (jalankan NasabahDemoSeeder).");
+                continue;
+            }
+
+            if (TransaksiSetoran::where('nasabah_id', $nasabah->id)->exists()) {
+                continue;   // sudah punya riwayat, jangan digandakan
+            }
+
+            // Tanggal: setoran pertama 55-68 hari lalu (setelah akun diverifikasi), sisanya acak.
+            // Nasabah yang akan nonaktif berhenti menyetor sejak 20 hari lalu (sebelum penarikan terakhir mereka).
+            $terbaru = $n['berhenti'] ? 20 : 0;
+            $hari = [mt_rand(55, 68)];
+            for ($i = 1; $i < $n['setoran']; $i++) {
+                $hari[] = mt_rand($terbaru, 55);
+            }
+            if (in_array($n['email'], self::SETORAN_HARI_INI, true)) {
+                $hari[count($hari) - 1] = 0;
+            }
+            rsort($hari);   // dari yang paling lama
+
+            foreach ($hari as $urutan => $hariLalu) {
+                $waktu = $sekarang->copy()->startOfDay()->subDays($hariLalu)->setTime(mt_rand(8, 16), mt_rand(0, 59));
+                if ($waktu->greaterThan($sekarang->copy()->subMinutes(45))) {
+                    $waktu = $sekarang->copy()->subMinutes(45 + mt_rand(0, 60));   // jangan di masa depan
+                }
+
+                $batal = null;
+                if ((self::DIBATALKAN[$n['email']] ?? null) === $urutan + 1) {
+                    $batal = $alasan[$noAlasan++ % count($alasan)];
+                }
+
+                $acara[] = [
+                    'waktu'      => $waktu,
+                    'nasabah_id' => $nasabah->id,
+                    'items'      => $this->isiSetoran($nama),
+                    'batal'      => $batal,
+                ];
+            }
+        }
+
+        mt_srand();   // kembalikan ke acak biasa
+
+        usort($acara, fn ($a, $b) => $a['waktu']->getTimestamp() <=> $b['waktu']->getTimestamp());
+
+        return $acara;
+    }
+
+    /** @return array<string, float> nama jenis => berat kg (kelipatan 0,25) */
+    private function isiSetoran(array $nama): array
+    {
+        $r = mt_rand(1, 100);
+        $banyak = $r <= 30 ? 1 : ($r <= 65 ? 2 : ($r <= 90 ? 3 : 4));
+
+        $pilihan = $nama;
+        shuffle($pilihan);
+
+        $items = [];
+        foreach (array_slice($pilihan, 0, $banyak) as $jenis) {
+            [$min, $max] = DemoRoster::KISARAN_BERAT[$jenis];
+            $berat = round((mt_rand((int) ($min * 4), (int) ($max * 4))) / 4, 2);
+            $items[$jenis] = max(0.25, $berat);
+        }
+
+        return $items;
+    }
+}
