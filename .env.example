APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Nomor WhatsApp admin (tombol "Hubungi Admin" di pojok kanan bawah)
ADMIN_WHATSAPP=
ADMIN_WHATSAPP_PESAN="Halo Admin Bank Sampah Sahabat Ibu, saya ingin bertanya."

# Akun admin pertama, dipakai `php artisan db:seed` (AdminSeeder). WAJIB diisi sebelum seeding.
# Kata sandi minimal 8 karakter, kombinasi huruf dan angka; admin dipaksa menggantinya saat login pertama.
# Seeder TIDAK menimpa admin yang sudah ada. Jika lupa kata sandi admin, set ADMIN_RESET_PASSWORD=true,
# jalankan `php artisan db:seed --class=AdminSeeder`, lalu kembalikan ke false.
ADMIN_NAME="Admin Bank Sampah"
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_RESET_PASSWORD=false

# Batas maksimal penarikan per pengajuan untuk nasabah kategori umum; 0 menonaktifkan batas.
BATAS_PENARIKAN_UMUM=100000
